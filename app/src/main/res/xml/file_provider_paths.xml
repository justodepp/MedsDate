<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Internal files directory for medicine images -->
    <files-path
        name="medicine_images"
        path="images/" />

    <!-- Camera images directory in external storage -->
    <external-files-path
        name="camera_images"
        path="Pictures/" />

    <!-- Cache directory for temporary files -->
    <cache-path
        name="cache_images"
        path="images/" />

    <!-- External storage for user-selected images -->
    <external-path
        name="external_files"
        path="." />
</paths>
